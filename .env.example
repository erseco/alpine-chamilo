# Published image; leave unset to use a local `docker compose build`.
CHAMILO_IMAGE=erseco/alpine-chamilo:3.0.2
CHAMILO_PORT=8080

DB_PASSWORD=replace-with-a-strong-random-password
DB_ROOT_PASSWORD=replace-with-another-strong-random-password

# Unattended installation on first start. Setting it to true accepts Chamilo's GPLv3 license.
CHAMILO_AUTO_INSTALL=true
CHAMILO_URL=http://127.0.0.1:8080
CHAMILO_ADMIN_PASSWORD=replace-with-an-administrator-password
CHAMILO_ADMIN_EMAIL=admin@example.org
CHAMILO_LANGUAGE=en_US

# Web installer instead: set CHAMILO_AUTO_INSTALL=false and this to true until installation finishes.
CHAMILO_INSTALLER_ENABLED=false

# Optional: comma-separated trusted proxy IP addresses or CIDR ranges
CHAMILO_TRUSTED_PROXIES=

# Switch both to ro after installation
CHAMILO_STATE_MODE=rw
CHAMILO_CONFIG_MODE=rw
