DB_PASSWORD=replace-with-a-strong-random-password
DB_ROOT_PASSWORD=replace-with-another-strong-random-password
# Optional: comma-separated trusted proxy IP addresses or CIDR ranges
CHAMILO_TRUSTED_PROXIES=
# Enable the installer only while it is restricted to trusted users
CHAMILO_INSTALLER_ENABLED=true
# Switch both to ro after successful installation
CHAMILO_STATE_MODE=rw
CHAMILO_CONFIG_MODE=rw
